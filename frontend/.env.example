# ==============================================================================
# PolicyLens — Frontend Environment Variables Example
# Copy this file to .env or .env.local in development.
# NEVER commit .env or real credentials to Git.
# ==============================================================================

# Public API base URL (client accessible)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# Neon PostgreSQL Database Configuration (Free Tier Compatible)
# ------------------------------------------------------------------------------
# DATABASE_URL:
# Pooled connection string used at runtime by Next.js and Prisma Client.
# Obtained from Neon Console with 'Connection pooling' checked.
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL:
# Direct unpooled connection string used by Prisma CLI for migrations and DDL.
# Obtained from Neon Console with 'Direct connection' checked.
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# Resend Email Service Configuration
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="PolicyLens <onboarding@resend.dev>"
